rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regla por defecto: denegar todo acceso público
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Regla de almacenamiento personal: solo el dueño de la carpeta tiene accesos
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
