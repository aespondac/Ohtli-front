rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Denegar accesos por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Regla de avatares: lectura pública para que cualquier dispositivo pueda descargarla,
    // pero escritura restringida exclusivamente al dueño autenticado.
    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regla para imágenes de viajes
    match /users/{userId}/trips/{tripId}/{allPaths=**} {
      // Lectura pública de fotos de viaje para compartición en redes y visitantes
      allow read: if true;
      // Sólo el dueño puede subir, modificar o borrar
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
