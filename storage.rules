rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo imágenes de hasta 10 MB (la app sube JPEG ya recortados y comprimidos)
    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isOwnerImageUpload(userId) {
      return isOwner(userId) && isImageUpload();
    }
    // Quien edita el viaje: el dueño o un coautor (coAuthorIds del viaje en Firestore, igual que
    // isTripEditor en firestore.rules). Regla entre servicios: el agente de Storage necesita el rol
    // roles/firebaserules.firestoreServiceAgent. El dueño no gasta la lectura de Firestore; si el
    // viaje no existe, get() da null y se niega.
    function isTripEditor(userId, tripId) {
      return isOwner(userId) || (request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/users/$(userId)/trips/$(tripId)).data.get('coAuthorIds', []));
    }

    // Superusuario de Ohtli (igual que isSuperUser en firestore.rules y kSuperUserEmail).
    function isSuperUser() {
      return request.auth != null
        && request.auth.token.email == 'daniesponda120@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Denegar accesos por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Regla de avatares: lectura pública para que cualquier dispositivo pueda descargarla,
    // pero escritura restringida exclusivamente al dueño autenticado.
    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow create, update: if isOwnerImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    // Regla de portadas: lectura pública y escritura restringida al dueño
    match /users/{userId}/cover.jpg {
      allow read: if true;
      allow create, update: if isOwnerImageUpload(userId);
      allow delete: if isOwner(userId);
    }
    
    // Regla para imágenes de viajes
    match /users/{userId}/trips/{tripId}/{allPaths=**} {
      // Lectura pública de fotos de viaje para compartición en redes y visitantes
      allow read: if true;
      // El dueño sube, modifica o borra cualquier cosa del viaje
      allow create, update: if isOwnerImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    // Lo que guarda el editor de viajes, que los coautores también usan (si no pueden subir, sus
    // fotos se quedan en base64 en details/content y el documento pasa de 1 MB). Solo la portada
    // y las fotos de los bloques: la portada se reemplaza pero no se borra; en sections/ el editor
    // borra las fotos que ya no usa. viajeros/ y lo demás siguen siendo solo del dueño.
    match /users/{userId}/trips/{tripId}/cover.jpg {
      allow create, update: if isImageUpload() && isTripEditor(userId, tripId);
    }
    // Fotos donadas a un lugar del catálogo: las sube quien dona; lectura pública porque, si se
    // aprueban, son la foto del lugar.
    match /place_donations/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwnerImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    // Capturas y fotos de "Enviar comentarios": las sube quien comenta (hasta 5 MB) y solo las
    // ve el superusuario en "Comentarios de la app". Nadie las cambia después.
    match /app_feedback/{userId}/{feedbackId}/{fileName} {
      allow read: if isSuperUser();
      allow create: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    match /users/{userId}/trips/{tripId}/sections/{fileName} {
      allow create, update: if isImageUpload() && isTripEditor(userId, tripId);
      allow delete: if isTripEditor(userId, tripId);
    }
  }
}
