rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule: deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User profile rule: allow reading/deleting old profile matching user's authenticated email,
    // and full access to their own UID document.
    // Also allow any authenticated user to update ONLY the 'friends' array of other users to enable mutual friendship.
    
    // Collection Group rules for 'trips' (required for collectionGroup queries)
    match /{path=**}/trips/{tripId} {
      allow read: if (request.auth != null && (
        (resource.data != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) || 
        (resource.data != null && 'coAuthorIds' in resource.data && resource.data.coAuthorIds is list && request.auth.uid in resource.data.coAuthorIds) ||
        (resource.data != null && 'surpriseTargetIds' in resource.data && resource.data.surpriseTargetIds is list && request.auth.uid in resource.data.surpriseTargetIds)
      )) || (resource != null && resource.data != null && 'status' in resource.data && resource.data.status == 'published' && 'visibility' in resource.data && resource.data.visibility == 'public');
      
      allow update: if request.auth != null && (
        (resource.data != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) || 
        (resource.data != null && 'coAuthorIds' in resource.data && resource.data.coAuthorIds is list && request.auth.uid in resource.data.coAuthorIds) ||
        (resource.data != null && 'surpriseTargetIds' in resource.data && resource.data.surpriseTargetIds is list && request.auth.uid in resource.data.surpriseTargetIds)
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        (resource != null && resource.data != null && request.auth.token.email == resource.data.email)
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']))
      );
      
      // Notifications Subcollection: Users can see their own notifications.
      // Anyone authenticated can create notifications (for sending friend requests).
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Trips Collection
      match /trips/{tripId} {
        // Read: Owner, co-author (list), surprise target (list), or public if published & public
        allow read: if (request.auth != null && (
          request.auth.uid == userId || 
          (resource.data.coAuthorIds != null && request.auth.uid in resource.data.coAuthorIds) ||
          (resource.data.surpriseTargetIds != null && request.auth.uid in resource.data.surpriseTargetIds)
        )) || (resource != null && resource.data.status == 'published' && resource.data.visibility == 'public');
        
        // Create/Delete: Only owner
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        
        // Update: Owner, co-author, or surprise target (to mark as opened)
        allow update: if request.auth != null && (
          request.auth.uid == userId || 
          (resource.data.coAuthorIds != null && request.auth.uid in resource.data.coAuthorIds) ||
          (resource.data.surpriseTargetIds != null && request.auth.uid in resource.data.surpriseTargetIds)
        );
        
        // Trip Details Content
        match /details/content {
          // Read: Owner, co-author, surprise target, or public if parent trip is published & public
          allow read: if (request.auth != null && (
            request.auth.uid == userId || 
            (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds) ||
            (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.surpriseTargetIds != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.surpriseTargetIds)
          )) || (
            get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.status == 'published' && 
            get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.visibility == 'public'
          );
          
          // Write: Owner or co-author
          allow write: if request.auth != null && (
            request.auth.uid == userId || 
            (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds)
          );
        }
      }
    }

    // Friend Requests Collection: Authenticated users can read/write requests where they are sender or receiver.
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Titles Collection
    match /titles/{titleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
