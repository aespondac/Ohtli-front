rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule: deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User profile rule: allow reading/deleting old profile matching user's authenticated email,
    // and full access to their own UID document.
    match /users/{userId} {
      allow read, delete: if request.auth != null && (
        request.auth.uid == userId || 
        (resource != null && resource.data != null && request.auth.token.email == resource.data.email)
      );
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
