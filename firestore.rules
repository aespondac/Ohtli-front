rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule: deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User profile rule: allow reading/deleting old profile matching user's authenticated email,
    // and full access to their own UID document.
    // Also allow any authenticated user to update ONLY the 'friends' array of other users to enable mutual friendship.
    match /users/{userId} {
      allow read: if true;
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        (resource != null && resource.data != null && request.auth.token.email == resource.data.email)
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']))
      );
      
      // Notifications Subcollection: Users can see their own notifications.
      // Anyone authenticated can create notifications (for sending friend requests).
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Trips Collection
      match /trips/{tripId} {
        // Read: Owner or public if published & public
        allow read: if (request.auth != null && request.auth.uid == userId) || (resource != null && resource.data.status == 'published' && resource.data.visibility == 'public');
        
        // Write: Only owner
        allow write: if request.auth != null && request.auth.uid == userId;
        
        // Trip Details Content
        match /details/content {
          // Read: Owner or public if parent trip is published & public
          allow read: if (request.auth != null && request.auth.uid == userId) || (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.status == 'published' && get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.visibility == 'public');
          
          // Write: Only owner
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Friend Requests Collection: Authenticated users can read/write requests where they are sender or receiver.
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Titles Collection
    match /titles/{titleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
