rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Códigos de SSO entre subdominios (ohtli.quest → lab.ohtli.quest): solo los lee y
    // escribe la Cloud Function ssoBridge con el Admin SDK. Ningún cliente tiene acceso.
    match /sso_codes/{codeHash} {
      allow read, write: if false;
    }

    // Superusuario de Ohtli (aprueba lugares sugeridos y publica notas de versión).
    // Debe coincidir con kSuperUserEmail en lib/config/admin.dart.
    function isSuperUser() {
      return request.auth != null
        && request.auth.token.email == 'daniesponda120@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Las notas de versión (kind == 'release_notes') solo las guarda el superusuario,
    // y sin coautores: nadie que no sea administrador puede figurar como autor.
    function notReleaseNotesUnlessSuper() {
      return !('kind' in request.resource.data)
        || request.resource.data.kind != 'release_notes'
        || (isSuperUser() && request.resource.data.get('coAuthorIds', []).size() == 0);
    }

    // --- Viajes: qué puede cambiar cada participante ---
    // Coautor: edita el contenido, pero no el dueño ni quién participa.
    function coAuthorUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['userId', 'coAuthorIds', 'surpriseTargetIds']);
    }
    // Destinatario de una sorpresa: solo marca que la abrió (agregándose a sí mismo).
    function surpriseOpenUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['surpriseOpenedBy'])
        && request.resource.data.surpriseOpenedBy.toSet()
             .difference(resource.data.get('surpriseOpenedBy', []).toSet())
             .hasOnly([request.auth.uid]);
    }
    // Miembro del viaje: dueño, coautor o destinatario de la sorpresa.
    function isTripMember(ownerId, tripId) {
      let trip = get(/databases/$(database)/documents/users/$(ownerId)/trips/$(tripId)).data;
      return request.auth != null && (
        request.auth.uid == ownerId ||
        request.auth.uid in trip.get('coAuthorIds', []) ||
        request.auth.uid in trip.get('surpriseTargetIds', [])
      );
    }
    // Quien edita el viaje: el dueño o un coautor (votan en las propuestas de lugares).
    function isTripEditor(ownerId, tripId) {
      return request.auth != null && (
        request.auth.uid == ownerId ||
        request.auth.uid in get(/databases/$(database)/documents/users/$(ownerId)/trips/$(tripId)).data.get('coAuthorIds', [])
      );
    }
    // Viaje publicado y público: cualquiera puede leer su contenido.
    function isPublicTrip(ownerId, tripId) {
      let trip = get(/databases/$(database)/documents/users/$(ownerId)/trips/$(tripId)).data;
      return trip.get('status', '') == 'published' && trip.get('visibility', '') == 'public';
    }
    // Invitado a un plan en grupo que aceptó: se suma a sí mismo como coautor (y nada más).
    function groupJoinUpdateOk(data) {
      return data.get('groupTripId', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coAuthorIds', 'coAuthorNames'])
        && request.resource.data.get('coAuthorIds', []).toSet()
             .difference(data.get('coAuthorIds', []).toSet()).hasOnly([request.auth.uid])
        && data.get('coAuthorIds', []).toSet()
             .difference(request.resource.data.get('coAuthorIds', []).toSet()).size() == 0
        && get(/databases/$(database)/documents/group_trips/$(data.groupTripId)).data.hostId == data.get('userId', '')
        && request.auth.uid in get(/databases/$(database)/documents/group_trips/$(data.groupTripId)).data.get('invitedIds', [])
        && get(/databases/$(database)/documents/group_trips/$(data.groupTripId)).data.get('responses', {})
             .get(request.auth.uid, '') == 'accepted';
    }
    // Quien se retira de un plan en grupo (su respuesta ya es 'declined') deja de ser coautor:
    // solo se quita a sí mismo, sin agregar a nadie.
    function groupLeaveUpdateOk(data) {
      return data.get('groupTripId', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coAuthorIds', 'coAuthorNames'])
        && data.get('coAuthorIds', []).toSet()
             .difference(request.resource.data.get('coAuthorIds', []).toSet()).hasOnly([request.auth.uid])
        && request.resource.data.get('coAuthorIds', []).toSet()
             .difference(data.get('coAuthorIds', []).toSet()).size() == 0
        && request.resource.data.get('coAuthorNames', []).toSet()
             .difference(data.get('coAuthorNames', []).toSet()).size() == 0
        && get(/databases/$(database)/documents/group_trips/$(data.groupTripId)).data.hostId == data.get('userId', '')
        && get(/databases/$(database)/documents/group_trips/$(data.groupTripId)).data.get('responses', {})
             .get(request.auth.uid, '') == 'declined';
    }
    function tripUpdateAllowed(data) {
      return request.auth != null && (
        request.auth.uid == data.get('userId', '') ||
        (data.get('coAuthorIds', []) is list && request.auth.uid in data.get('coAuthorIds', []) && coAuthorUpdateOk()) ||
        (data.get('surpriseTargetIds', []) is list && request.auth.uid in data.get('surpriseTargetIds', []) && surpriseOpenUpdateOk()) ||
        groupJoinUpdateOk(data) ||
        groupLeaveUpdateOk(data)
      );
    }

    // --- Viajes en grupo (group_trips/{id}) ---
    // Cambia solo la llave del propio usuario dentro de un mapa (respuesta, intención, voto).
    function onlyOwnKeyChanged(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    // --- Relaciones sociales (users/{uid}/social/*) ---
    // Otro usuario solo puede agregarse o quitarse a sí mismo de las listas permitidas.
    function selfOnlyListChange(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }
    function selfOnlyListCreate(field) {
      return request.resource.data.get(field, []).toSet().hasOnly([request.auth.uid]);
    }
    function othersSelfOnlyUpdate(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields)
        && (!('friends' in fields) || selfOnlyListChange('friends'))
        && (!('followers' in fields) || selfOnlyListChange('followers'))
        && (!('closeFriendOf' in fields) || selfOnlyListChange('closeFriendOf'));
    }
    function othersSelfOnlyCreate(fields) {
      return request.resource.data.keys().hasOnly(fields)
        && (!('friends' in fields) || selfOnlyListCreate('friends'))
        && (!('followers' in fields) || selfOnlyListCreate('followers'))
        && (!('closeFriendOf' in fields) || selfOnlyListCreate('closeFriendOf'));
    }
    // La sesión tiene el mismo correo verificado que guarda users/{userId}/private/account
    // (restaurar una cuenta dada de baja).
    function sameVerifiedEmailAs(userId) {
      return request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/users/$(userId)/private/account) &&
        get(/databases/$(database)/documents/users/$(userId)/private/account).data.get('email', '') == request.auth.token.email;
    }
    function profileIsPrivate(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get('profilePrivate', false) == true;
    }

    // --- Amistades ---
    // Otro usuario solo puede tocar el campo 'friends' de tu perfil, y únicamente para
    // agregarse o quitarse a sí mismo (aceptar una solicitud o terminar la amistad).
    function onlyOwnUidInFriendsChange() {
      let before = resource.data.get('friends', []).toSet();
      let after = request.resource.data.get('friends', []).toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }
    
    // User profile rule: allow reading/deleting old profile matching user's authenticated email,
    // and full access to their own UID document.
    // Also allow any authenticated user to update ONLY the 'friends' array of other users to enable mutual friendship.
    
    // Collection Group rules for 'trips' (required for collectionGroup queries)
    match /{path=**}/trips/{tripId} {
      // Condiciones con .get(): Firestore puede comprobarlas a partir de los filtros
      // de la consulta (arrayContains en coAuthorIds / surpriseTargetIds). Con las
      // comprobaciones "'campo' in resource.data" las consultas de Mis viajes se rechazaban.
      allow read: if (request.auth != null && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid in resource.data.get('coAuthorIds', []) ||
        request.auth.uid in resource.data.get('surpriseTargetIds', [])
      )) || (resource.data.get('status', '') == 'published' && resource.data.get('visibility', '') == 'public');
      
      allow update: if tripUpdateAllowed(resource.data) && notReleaseNotesUnlessSuper();
    }

    // Perfil visible para los demás: solo campos de presentación. Lo escribe su dueño al
    // guardar su perfil (lib/services/public_profiles.dart). Lo lee cualquiera, igual que
    // el visor de viajes públicos sin sesión.
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'updatedAt', 'displayName', 'photoURL', 'coverURL', 'coverUrl', 'usertag',
          'activeTitleId', 'possessedTitles', 'moments', 'createdAt', 'profilePrivate', 'isDeleted'
        ])
        && request.resource.data.get('uid', userId) == userId;
      allow delete: if request.auth != null && (
        request.auth.uid == userId || sameVerifiedEmailAs(userId)
      );
    }

    match /users/{userId} {
      // Solo su dueño lo lee. Lo que ven los demás (nombre, foto, usertag, título,
      // portada, momentos) está en /public_profiles/{userId}; los datos personales y el
      // perfil de gustos, en /users/{userId}/private/account. El motor y las Cloud
      // Functions usan el Admin SDK, que no pasa por estas reglas.
      // Excepción: restaurar una cuenta dada de baja con el mismo correo verificado.
      allow read: if request.auth != null && (
        request.auth.uid == userId || sameVerifiedEmailAs(userId)
      );
      // Borrar un perfil antiguo dado de baja: solo con el mismo correo verificado
      // (el correo vive en el documento privado).
      allow delete: if request.auth != null && (
        request.auth.uid == userId || sameVerifiedEmailAs(userId)
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId || onlyOwnUidInFriendsChange()
      );

      // Amigos, seguidos y seguidores: el dueño, sus amigos y, si el perfil es público, todos.
      match /social/graph {
        allow read: if (request.auth != null && request.auth.uid == userId)
          || !profileIsPrivate(userId)
          || (request.auth != null && resource != null && request.auth.uid in resource.data.get('friends', []));
        allow create: if request.auth != null && (request.auth.uid == userId
          || othersSelfOnlyCreate(['friends', 'followers']));
        allow update: if request.auth != null && (request.auth.uid == userId
          || othersSelfOnlyUpdate(['friends', 'followers']));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      // Mejores amigos: solo su dueño los ve. Los demás solo marcan si lo tienen como
      // mejor amigo (closeFriendOf), agregándose o quitándose a sí mismos.
      match /social/close {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && (request.auth.uid == userId
          || othersSelfOnlyCreate(['closeFriendOf']));
        allow update: if request.auth != null && (request.auth.uid == userId
          || othersSelfOnlyUpdate(['closeFriendOf']));
      }

      // Datos personales (correo, teléfono, direcciones, privacidad): solo su dueño.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Tokens de avisos push (FCM), uno por dispositivo: solo su dueño. Las Cloud Functions los
      // leen con el Admin SDK para mandar cada aviso (functions/push.js).
      match /push_tokens/{token} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'standalone', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.platform is string
          && request.resource.data.updatedAt == request.time;
      }
      
      // Notifications Subcollection: Users can see their own notifications.
      // Anyone authenticated can create notifications (for sending friend requests).
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Crear: para ti mismo, o a otro usuario firmando con tu propio uid como remitente.
        allow create: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.get('senderId', '') == request.auth.uid
        );
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Trips Collection
      match /trips/{tripId} {
        // Read: Owner, co-author (list), surprise target (list), or public if published & public
        allow read: if (request.auth != null && (
          request.auth.uid == userId || 
          (resource.data.coAuthorIds != null && request.auth.uid in resource.data.coAuthorIds) ||
          (resource.data.surpriseTargetIds != null && request.auth.uid in resource.data.surpriseTargetIds)
        )) || (resource != null && resource.data.status == 'published' && resource.data.visibility == 'public');
        
        // Create/Delete: Only owner (y notas de versión solo el superusuario)
        allow create: if request.auth != null && request.auth.uid == userId && notReleaseNotesUnlessSuper();
        allow delete: if request.auth != null && request.auth.uid == userId;
        
        // Update: Owner, co-author, or surprise target (to mark as opened)
        allow update: if tripUpdateAllowed(resource.data) && notReleaseNotesUnlessSuper();
        
        // Trip Details Content
        match /details/content {
          // Read: Owner, co-author, surprise target, or public if parent trip is published & public
          allow read: if (request.auth != null && (
            request.auth.uid == userId || 
            (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds) ||
            (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.surpriseTargetIds != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.surpriseTargetIds)
          )) || (
            get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.status == 'published' && 
            get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.visibility == 'public'
          );
          
          // Write: Owner or co-author
          allow write: if request.auth != null && (
            request.auth.uid == userId || 
            (get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds != null && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.coAuthorIds)
          );
        }

        // --- Mensajes y reacciones del grupo ---
        // Los lee cualquiera que pueda leer el viaje (miembros, o todos si es público);
        // solo los miembros del viaje escriben y reaccionan.
        // Mensajes tipo burbuja anclados a un bloque.
        match /notes/{noteId} {
          allow read: if isTripMember(userId, tripId) || isPublicTrip(userId, tripId);
          allow create: if isTripMember(userId, tripId)
            && request.resource.data.keys().hasOnly(['blockId', 'authorId', 'authorName', 'authorPhoto', 'text', 'createdAt', 'reactions'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.blockId is string
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.get('reactions', {}).size() == 0;
          // El autor edita su texto; cualquier miembro cambia solo su propia reacción.
          allow update: if isTripMember(userId, tripId) && (
            (request.auth.uid == resource.data.authorId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
          );
          allow delete: if isTripMember(userId, tripId)
            && (request.auth.uid == resource.data.authorId || request.auth.uid == userId);
        }

        // Reacciones a un bloque: un documento por bloque, un campo por usuario.
        match /reactions/{blockId} {
          allow read: if isTripMember(userId, tripId) || isPublicTrip(userId, tripId);
          allow create: if isTripMember(userId, tripId)
            && request.resource.data.keys().hasOnly([request.auth.uid]);
          allow update: if isTripMember(userId, tripId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
          // Solo el dueño del viaje las borra (p. ej. al reemplazar el contenido del viaje).
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // Votos de una propuesta de lugares: un documento por propuesta, un campo por persona
        // (el lugar que eligió). Votan el dueño y los coautores; cada quien solo su voto.
        match /votes/{proposalId} {
          allow read: if isTripMember(userId, tripId);
          allow create: if isTripEditor(userId, tripId)
            && request.resource.data.keys().hasOnly([request.auth.uid]);
          allow update: if isTripEditor(userId, tripId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // Presencia en el editor (edición en vivo): quién lo tiene abierto y en qué bloque
        // escribe. La leen el dueño y los coautores; cada quien escribe solo su documento.
        match /presence/{uid} {
          allow read: if isTripEditor(userId, tripId);
          allow create, update: if isTripEditor(userId, tripId)
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['name', 'photo', 'blockId', 'lastSeen'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 120
            && (request.resource.data.get('photo', null) == null
                || (request.resource.data.photo is string && request.resource.data.photo.size() <= 2048))
            && (request.resource.data.get('blockId', null) == null
                || (request.resource.data.blockId is string && request.resource.data.blockId.size() <= 200))
            && request.resource.data.lastSeen == request.time;
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // «Seguir mi viaje» en el servidor (avisos para salir con Ohtli cerrado; functions/trip_follow.js).
    // Un documento por viaje y persona, id "{tripId}_{uid}": solo lo lee y escribe esa persona, y
    // solo para un viaje que puede editar (dueño o coautor). El servidor también lo revisa.
    match /trip_follows/{followId} {
      function followOwnId() {
        return request.auth != null && followId.matches('.+_' + request.auth.uid);
      }
      function canEditTrip(ownerId, tripId) {
        return request.auth.uid == ownerId || (
          exists(/databases/$(database)/documents/users/$(ownerId)/trips/$(tripId)) &&
          request.auth.uid in get(/databases/$(database)/documents/users/$(ownerId)/trips/$(tripId)).data.get('coAuthorIds', [])
        );
      }
      allow read, delete: if followOwnId() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if followOwnId()
        && request.resource.data.uid == request.auth.uid
        && followId == request.resource.data.tripId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'ownerId', 'tripId', 'day', 'tz', 'tzOffsetMin', 'enabled', 'sent', 'updatedAt'])
        && request.resource.data.enabled is bool
        && canEditTrip(request.resource.data.ownerId, request.resource.data.tripId);
      allow update: if followOwnId()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.enabled is bool
        && request.resource.data.get('sent', []).size() <= 100
        && request.resource.data.keys().hasOnly(['uid', 'ownerId', 'tripId', 'day', 'tz', 'tzOffsetMin', 'enabled', 'sent', 'updatedAt', 'endedBy', 'lastAlertAt']);
    }

    // Avisos con fecha en el futuro (planes sorpresa) esperando su push: solo las Cloud Functions.
    match /push_queue/{id} {
      allow read, write: if false;
    }

    // Friend Requests Collection: Authenticated users can read/write requests where they are sender or receiver.
    // Solo el remitente y el destinatario ven o modifican la solicitud.
    // Usertags (@nombre) únicos: cualquiera consulta uno exacto; nadie lista la colección.
    // Solo puedes reservar uno libre a tu nombre y liberar el tuyo.
    match /usertags/{tag} {
      allow get: if true;
      allow list: if false;
      // Reservados (Ohtli, personal, autoridades) y prohibidos (groserías, odio, delitos…):
      // la misma lista básica que lib/services/profile_directory.dart.
      allow create: if request.auth != null
        && tag.matches('^[a-z0-9._]{3,20}$')
        && !tag.matches('.*(ohtli|admin|soporte|support|oficial|official|staff|moderador|moderator).*')
        && !(tag in ['root', 'system', 'sistema', 'api', 'www', 'app', 'labs', 'null', 'undefined', 'help', 'ayuda', 'equipo', 'team', 'seguridad', 'security', 'gob', 'gobierno', 'cdmx', 'presidencia', 'policia', 'sat', 'imss', 'ine', 'verificado', 'verified', 'mod', 'info', 'contacto', 'contact', 'legal'])
        && !tag.matches('.*(puta|puto|pendej|verga|chinga|culero|mierda|cabron|pinche|joto|maricon|nazi|hitler|kkk|fuck|shit|bitch|nigg|porn|pedofil|pederast|violador|narco|sicario|terroris).*')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Correo y teléfono de perfiles públicos, solo como hash (sha256): se consulta uno exacto,
    // nunca se lista. Solo la función contactDirectory escribe (con datos verificados por
    // Firebase Auth: teléfono por SMS y correo verificado), así nadie registra los de otro.
    match /contact_directory/{hash} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /friend_requests/{requestId} {
      allow read: if request.auth != null &&
        request.auth.uid in [resource.data.get('senderId', ''), resource.data.get('receiverId', '')];
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.uid in [resource.data.get('senderId', ''), resource.data.get('receiverId', '')] &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId;
      allow delete: if request.auth != null &&
        request.auth.uid in [resource.data.get('senderId', ''), resource.data.get('receiverId', '')];
    }

    // Restaurar una cuenta dada de baja: buscar su documento privado por correo, solo si
    // el correo coincide con el de la sesión y está verificado.
    match /{path=**}/private/{docId} {
      allow read, delete: if request.auth != null &&
        request.auth.token.email_verified == true &&
        resource.data.get('email', '') == request.auth.token.email;
    }

    // Comentarios de "Enviar comentarios" (lib/widgets/feedback_dialog.dart). Cualquiera con
    // sesión crea el suyo; nadie los lee ni los cambia desde la app (ni los propios): la Cloud
    // Function feedbackEmail los manda por correo con el Admin SDK. Ver functions/feedback.js.
    match /app_feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'message', 'category', 'screen', 'appVersion',
             'browser', 'viewport', 'language', 'context', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 2000
        && request.resource.data.category in ['idea', 'bug', 'other']
        && request.resource.data.screen is string
        && request.resource.data.screen.size() <= 80
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 20
        && request.resource.data.get('browser', '') is string
        && request.resource.data.get('browser', '').size() <= 80
        && request.resource.data.get('viewport', '') is string
        && request.resource.data.get('viewport', '').size() <= 20
        && request.resource.data.get('language', '') is string
        && request.resource.data.get('language', '').size() <= 20
        && request.resource.data.get('context', {}) is map
        && request.resource.data.get('context', {}).size() <= 8
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Titles Collection
    match /titles/{titleId} {
      allow read: if true;
      // Los títulos son un catálogo fijo: se administran desde la consola
      allow write: if false;
    }

    // Labs Waitlist Collection
    match /labs_waitlist/{userId} {
      // Cada quien lee y crea su solicitud; se crea siempre "pending" (antes se podía crear ya
      // "approved" por REST). Solo el superusuario la aprueba o rechaza.
      allow read: if isSuperUser() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'agreedToTerms', 'status', 'updatedAt', 'createdAt']);
      allow update, delete: if isSuperUser();
    }

    // Yollotl Engine Jobs (Async ETL & Agents)
    match /recolector_jobs/{jobId} {
      allow read: if true;
    }
    // Solicitud de viaje en grupo. Quien organiza decide a quién invita; cada invitado responde,
    // suma su intención y vota solo en su propia llave: nadie responde por otro (el motor usa
    // los gustos de quien aceptó) y el organizador no puede marcar a nadie como "aceptó".
    match /group_trips/{groupId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.hostId ||
        request.auth.uid in resource.data.get('invitedIds', [])
      );
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && !(request.auth.uid in request.resource.data.get('invitedIds', []))
        && request.resource.data.get('responses', {}).size() == 0
        && request.resource.data.get('intentions', {}).size() == 0
        && request.resource.data.get('votes', {}).size() == 0
        && request.resource.data.get('declineReasons', {}).size() == 0;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.hostId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostId', 'responses', 'intentions', 'declineReasons'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['votes'])
              || (onlyOwnKeyChanged('votes') && resource.data.get('status', '') == 'voting')))
        ||
        (request.auth.uid in resource.data.get('invitedIds', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses', 'intentions', 'votes', 'declineReasons'])
          && onlyOwnKeyChanged('responses')
          && onlyOwnKeyChanged('intentions')
          && onlyOwnKeyChanged('votes')
          && onlyOwnKeyChanged('declineReasons')
          && request.resource.data.get('responses', {}).get(request.auth.uid, 'accepted') in ['accepted', 'declined']
          // Razón de no ir (al rechazar o al retirarse): texto corto
          && request.resource.data.get('declineReasons', {}).get(request.auth.uid, '') is string
          && request.resource.data.get('declineReasons', {}).get(request.auth.uid, '').size() <= 200
          // Votar solo en votación y habiendo aceptado; quitar el propio voto (al retirarse), siempre
          && (!request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasAny([request.auth.uid])
              || !(request.auth.uid in request.resource.data.get('votes', {}))
              || (resource.data.get('status', '') == 'voting'
                  && request.resource.data.get('responses', {}).get(request.auth.uid, '') == 'accepted')))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
    }

    match /itinerary_jobs/{jobId} {
      // El job incluye la solicitud del usuario (presupuesto, origen): solo su dueño lo lee.
      allow read: if request.auth != null && (
        (resource.data != null && 'user_id' in resource.data && resource.data.user_id == request.auth.uid) ||
        (resource.data != null && 'userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      allow create: if request.auth != null && (
        (!('user_id' in request.resource.data) && !('userId' in request.resource.data)) ||
        ('user_id' in request.resource.data && request.resource.data.user_id == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
      allow update: if request.auth != null && (
        (!('user_id' in resource.data) && !('userId' in resource.data)) ||
        ('user_id' in resource.data && resource.data.user_id == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('user_id' in request.resource.data && request.resource.data.user_id == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        (!('user_id' in resource.data) && !('userId' in resource.data)) ||
        ('user_id' in resource.data && resource.data.user_id == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    // Points of Interest (POIs) - Production & Lab Sandbox indexed by Yollotl Recolector
    match /pois/{poiId} {
      allow read: if true;
      // Solo el superusuario añade lugares (al aprobar una sugerencia); el motor escribe con su cuenta de servicio
      allow create, update: if isSuperUser();
      allow delete: if false;
    }

    // Configuración pública de la app (p. ej. app_config/editorial con el UID del superusuario,
    // para encontrar las notas de versión). Solo el superusuario la escribe.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isSuperUser();
    }

    // Lugares sugeridos desde el editor de viajes. Solo se usan en el viaje de quien los
    // sugiere hasta que el superusuario los aprueba (entonces se copian a /pois con el mismo id).
    match /poi_suggestions/{suggestionId} {
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 120
        && request.resource.data.keys().hasOnly(['name', 'category', 'location', 'address', 'description',
             'photo_url', 'price_mxn_avg', 'status', 'createdBy', 'createdByName', 'tripId', 'createdAt',
             'subcategories', 'vibe_tags', 'ideal_for', 'price_level', 'opening_hours', 'wheelchair_accessible',
             'musica_en_vivo', 'consumo_alcohol', 'area_verde_cercana', 'patrimonio_historico', 'tips']);
      allow read: if isSuperUser() || (request.auth != null && resource.data.createdBy == request.auth.uid);
      // El perfil (receta y vector) y la aprobación los escribe el motor con su cuenta de servicio
      allow update: if isSuperUser();
      allow delete: if isSuperUser() || (request.auth != null && resource.data.createdBy == request.auth.uid && resource.data.status == 'pending');

      // Información que aportan otras personas desde el visor mientras la sugerencia está pendiente
      match /contributions/{contributionId} {
        allow create: if request.auth != null
          && request.resource.data.by == request.auth.uid
          && get(/databases/$(database)/documents/poi_suggestions/$(suggestionId)).data.status == 'pending'
          && request.resource.data.keys().hasOnly(['subcategories', 'vibe_tags', 'ideal_for', 'price_level',
               'opening_hours', 'wheelchair_accessible', 'musica_en_vivo', 'consumo_alcohol', 'area_verde_cercana',
               'patrimonio_historico', 'tips', 'description', 'by', 'byName', 'createdAt']);
        allow read: if isSuperUser() || (request.auth != null && resource.data.by == request.auth.uid);
        allow update, delete: if isSuperUser();
      }
    }

    // Aportes a lugares del catálogo: fotos donadas y reportes (falta / está mal). Los crea quien
    // aporta, pendientes; solo el superusuario los aprueba o rechaza (y aplica el cambio en /pois).
    match /place_feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['photo', 'report']
        && request.resource.data.poiId is string
        && request.resource.data.poiId.size() > 0
        && exists(/databases/$(database)/documents/pois/$(request.resource.data.poiId))
        && request.resource.data.keys().hasOnly(['type', 'poiId', 'poiName', 'photoUrl', 'tripId', 'issues', 'note',
             'by', 'byName', 'status', 'createdAt'])
        && (request.resource.data.type != 'photo'
            || (request.resource.data.photoUrl is string
                && request.resource.data.photoUrl.matches('https://firebasestorage[.]googleapis[.]com/.*/o/place_donations%2F' + request.auth.uid + '%2F.*')))
        && (request.resource.data.type != 'report'
            || (request.resource.data.issues is list
                && request.resource.data.issues.size() > 0
                && request.resource.data.issues.size() <= 12))
        && request.resource.data.get('note', '').size() <= 500;
      allow read: if isSuperUser() || (request.auth != null && resource.data.by == request.auth.uid);
      allow update: if isSuperUser();
      allow delete: if isSuperUser() || (request.auth != null && resource.data.by == request.auth.uid && resource.data.status == 'pending');
    }

    match /pois_lab/{poiId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Ohtli Labs: pipeline de pruebas y resultados ---
    // Roles en lab_members/{uid}: researcher (miembro del laboratorio) y tester; el superusuario es admin.
    // Visibilidad de corridas y artículos: private (laboratorio) → testers → public (sin sesión).
    function labRole() {
      return request.auth == null ? '' :
        get(/databases/$(database)/documents/lab_members/$(request.auth.uid)).data.get('role', '');
    }
    function isLabMember() {
      return isSuperUser() || (request.auth != null
        && exists(/databases/$(database)/documents/lab_members/$(request.auth.uid))
        && labRole() in ['researcher', 'admin']);
    }
    function isLabTester() {
      return isLabMember() || (request.auth != null
        && exists(/databases/$(database)/documents/lab_members/$(request.auth.uid))
        && labRole() == 'tester');
    }
    // Condición explícita sobre resource.data.visibility para que las consultas filtradas
    // (visibility in ['public'] o ['testers', 'public']) se puedan autorizar.
    // Solo el superusuario abre algo al público.
    function publicOnlyBySuper() {
      return request.resource.data.get('visibility', 'private') != 'public' || isSuperUser();
    }

    match /lab_members/{uid} {
      allow read: if isLabMember() || (request.auth != null && request.auth.uid == uid);
      // Alta propia como tester (solo crear: así un miembro no puede quedar degradado a tester si
      // acepta el consentimiento por error), o aceptación de una invitación para el correo verificado.
      allow create: if isSuperUser() || (request.auth != null && request.auth.uid == uid && (
          (request.resource.data.role == 'tester' && request.resource.data.keys().hasOnly(['role', 'via', 'consent', 'joinedAt']))
          || (request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/lab_invites/$(request.auth.token.email.lower()))
              && request.resource.data.role == get(/databases/$(database)/documents/lab_invites/$(request.auth.token.email.lower())).data.role)));
      allow update: if isSuperUser() || (request.auth != null && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/lab_invites/$(request.auth.token.email.lower()))
          && request.resource.data.role == get(/databases/$(database)/documents/lab_invites/$(request.auth.token.email.lower())).data.role);
      allow delete: if isSuperUser() || (request.auth != null && request.auth.uid == uid);
    }
    match /lab_invites/{email} {
      allow read: if isSuperUser() || (request.auth != null && request.auth.token.email.lower() == email);
      allow write: if isSuperUser();
      // Quien la acepta la borra: si se quedaba, roleOf() la volvía a aceptar y "Quitar del
      // laboratorio" o "Dejar de ser tester" no surtían efecto.
      allow delete: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }
    match /lab_runs/{runId} {
      allow read: if resource.data.visibility == 'public'
        || (resource.data.visibility == 'testers' && isLabTester())
        || isLabMember()
        || (isLabTester() && resource.data.evalSource == true);
      allow create: if isLabMember() && publicOnlyBySuper();
      allow update: if isLabMember() && publicOnlyBySuper();
      allow delete: if isSuperUser();
      match /rows/{rowId} {
        allow read: if isLabMember()
          || get(/databases/$(database)/documents/lab_runs/$(runId)).data.visibility == 'public'
          || (isLabTester() && get(/databases/$(database)/documents/lab_runs/$(runId)).data.visibility == 'testers')
          || (isLabTester() && get(/databases/$(database)/documents/lab_runs/$(runId)).data.evalSource == true);
        allow write: if isLabMember();
      }
    }
    match /lab_posts/{postId} {
      allow read: if isLabMember()
        || (resource.data.status == 'published' && resource.data.visibility == 'public')
        || (resource.data.status == 'published' && resource.data.visibility == 'testers' && isLabTester());
      allow create, update: if isLabMember()
        && (request.resource.data.get('status', 'draft') != 'published' || publicOnlyBySuper());
      allow delete: if isSuperUser();
    }
    // Estado de cada estudio (activo para testers, corrida fuente): lectura pública.
    match /lab_studies/{studyId} {
      allow read: if true;
      allow write: if isLabMember();
    }
    match /lab_site/{docId} {
      allow read: if isLabMember();
      allow write: if isLabMember();
    }
    // Respuestas de testers: anónimas (solo el uid para evitar duplicados), visibles solo para el laboratorio.
    // Una por persona: el ID es determinista (sus_<uid>, rel_<uid>_<corrida>_<fila>_<alternativa>) y solo se
    // permite crear, así que reenviar no duplica. Los valores se validan (escalas 1–5): antes un valor
    // fuera de rango rompía el panel y sesgaba los agregados publicados.
    function likert5(l, minSize, maxSize) {
      return l is list && l.size() >= minSize && l.size() <= maxSize && l.hasOnly([1, 2, 3, 4, 5]);
    }
    function optionalShortString(m, key) {
      return m.get(key, null) == null || (m.get(key, null) is string && m.get(key, '').size() <= 60);
    }
    function validSusResponse(responseId, d) {
      return responseId == 'sus_' + request.auth.uid
        && likert5(d.get('sus', null), 10, 10)
        && likert5(d.get('satisfaction', null), 1, 10)
        && d.get('tasks', null) is list && d.tasks.size() >= 1 && d.tasks.size() <= 10
        && d.tasks.hasOnly(['completada', 'con dificultad', 'no completada'])
        && d.get('profile', null) is map
        && d.profile.keys().hasOnly(['visitor_type', 'age_range', 'device'])
        && d.profile.get('visitor_type', null) is string
        && optionalShortString(d.profile, 'visitor_type')
        && optionalShortString(d.profile, 'age_range')
        && optionalShortString(d.profile, 'device');
    }
    function validRelevanceResponse(responseId, d) {
      return d.get('runId', null) is string && d.get('rowIndex', null) is int && d.get('optionIndex', null) is int
        && responseId == 'rel_' + request.auth.uid + '_' + d.runId + '_' + string(d.rowIndex) + '_' + string(d.optionIndex)
        && d.runId == get(/databases/$(database)/documents/lab_studies/relevancia).data.get('sourceRunId', '')
        && likert5(d.get('grades', null), 1, 12);
    }
    match /lab_responses/{responseId} {
      allow create: if isLabTester()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.consent == true
        && request.resource.data.studyId in ['sus', 'relevancia']
        && get(/databases/$(database)/documents/lab_studies/$(request.resource.data.studyId)).data.active == true
        && request.resource.data.keys().hasOnly(['studyId', 'uid', 'consent', 'createdAt', 'sus', 'satisfaction', 'tasks',
             'profile', 'comment', 'runId', 'rowIndex', 'scenarioId', 'optionIndex', 'theme', 'mood', 'poiIds', 'grades', 'criterion'])
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000))
        && ((request.resource.data.studyId == 'sus' && validSusResponse(responseId, request.resource.data))
            || (request.resource.data.studyId == 'relevancia' && validRelevanceResponse(responseId, request.resource.data)));
      // Cada tester puede ver las suyas (para no repetir lo que ya respondió); el laboratorio, todas.
      allow read: if isLabMember() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isLabMember();
    }
  }
}
